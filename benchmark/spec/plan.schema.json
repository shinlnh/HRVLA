{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HRVLA immutable paired episode plan",
  "type": "object",
  "required": [
    "schema_version",
    "suite_id",
    "suite_sha256",
    "plan_sha256",
    "methods",
    "controller_contract",
    "episodes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "suite_id": {"type": "string", "minLength": 1},
    "suite_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "controller_contract": {"type": "object"},
    "episodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "episode_key",
          "task_id",
          "scenario_id",
          "protocol",
          "training_seed",
          "rollout_seed",
          "initial_snapshot_id",
          "success_predicate",
          "horizon_s",
          "admission_status"
        ]
      }
    }
  },
  "additionalProperties": false
}
