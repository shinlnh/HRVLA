{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HRVLA run provenance manifest",
  "type": "object",
  "required": [
    "schema_version",
    "suite_id",
    "suite_sha256",
    "plan_sha256",
    "repository_revision",
    "repository_dirty",
    "host",
    "controller_contract"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "suite_id": {"type": "string", "minLength": 1},
    "suite_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository_dirty": {"type": "boolean"},
    "host": {
      "type": "object",
      "required": ["platform", "python"],
      "properties": {
        "platform": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "controller_contract": {"type": "object"}
  },
  "additionalProperties": false
}
