  "protocols": {
    "nominal": {
      "failure_injection": false,
      "purpose": "Measure ordinary task success and recovery-module regression"
    },
    "failure_start": {
      "failure_injection": false,
      "start_state": "shared immutable post-failure simulator snapshot",
      "purpose": "Isolate recovery competence from pre-failure execution quality"
    },
    "online_failure": {
      "failure_injection": true,
      "trigger": "shared semantic event or sub-task boundary",
      "purpose": "Evaluate detection, diagnosis, recovery, and continuation end to end"
    }
  },
  "recovery_levels": {
    "L1": "Action retry; task state is materially unchanged",
    "L2": "Action adaptation; object state changed but remains directly usable",
    "L3": "Object-state restoration before the original task can continue",
    "L4": "Environment restoration involving a blocking non-target state or object"
  },
  "humanoid_axes": {
    "H1": "Body-state recovery: support, balance, foot placement, or recoverable fall state",
    "H2": "Policy-tracker failure: valid high-level intent is not realized by the tracker",
    "H3": "Coupled failure: body-state and task/object-state disruption co-occur"
  },
  "replication": {
    "training_seeds": [0, 1, 2],
    "rollouts_per_seed_per_cell": 20,
    "paired_rollout_seeds_across_methods": true
  },
  "artifact_policy": {
    "dataset_remote": "https://huggingface.co/datasets/shin0412/HRVLA",
    "required_before_admission": [
      "immutable initial and failure snapshot hashes",
      "injector implementation revision",
      "oracle checkpoint and 20/20 recovery trials",
      "task and safety predicate tests"
    ],
    "draft_execution": "forbidden in claim-bearing reports"
  },
